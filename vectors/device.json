{
  "version": 1,
  "vectors": [
    {
      "id": "version-over-ear",
      "kind": "payload",
      "command": "fw_version",
      "payload": "032200000000",
      "decoded": {
        "versions": [
          "3.34.0",
          "0.0.0"
        ]
      },
      "provenance": {
        "kind": "observed",
        "device": "accentum-wireless",
        "date": "2026-09-12",
        "note": "Six bytes, not three: the version followed by a zero triple. The vendor application displayed 3.34.0 for this device, which is what makes the first triple's reading certain rather than plausible."
      }
    },
    {
      "id": "version-earbuds-per-bud",
      "kind": "payload",
      "command": "fw_version",
      "payload": "051601051601",
      "decoded": {
        "versions": [
          "5.22.1",
          "5.22.1"
        ]
      },
      "provenance": {
        "kind": "observed",
        "device": "momentum-tw4",
        "date": "2026-09-12",
        "note": "The same version twice, one per earbud, against 5.22.1 shown in the vendor application. A decoder reading only the first triple would be right and would miss the only field anywhere in this protocol that separates the two buds."
      }
    },
    {
      "id": "version-truncated-is-invalid",
      "kind": "payload",
      "command": "fw_version",
      "payload": "0322",
      "error": "invalid_length",
      "provenance": {
        "kind": "constructed",
        "rationale": "Two bytes cannot carry major, minor and patch. Accepting them would report a patch level of zero that the device never sent."
      }
    },
    {
      "id": "version-wide-over-ear",
      "kind": "payload",
      "command": "fw_version_wide",
      "payload": "000300220000",
      "decoded": {
        "version": "3.34.0"
      },
      "provenance": {
        "kind": "observed",
        "device": "accentum-wireless",
        "date": "2026-09-12",
        "note": "The same version as the other encoding, as three 16-bit big-endian fields. Two commands that must agree are a free check on a decoder written from scratch."
      }
    },
