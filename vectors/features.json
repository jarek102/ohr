          {
            "id": 10,
            "name": "device_management",
            "version": 2
          }
        ]
      },
      "provenance": {
        "kind": "constructed",
        "rationale": "Neither device set the flag, so no capture exists. When it is set, a second request must be issued and the maps merged; a client that stops here gets a partial map and can pick the wrong connection command family."
      }
