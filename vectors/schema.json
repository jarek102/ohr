{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jarek102/ohr/vectors/schema.json",
  "title": "ohr test vectors",
  "description": "Language-neutral conformance fixtures. Any implementation is correct exactly insofar as it reproduces these.",
  "type": "object",
  "required": [
    "version",
    "vectors"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/vector"
      }
    }
  },
  "$defs": {
    "hex": {
      "type": "string",
      "description": "Lowercase hex, no separators. May be empty.",
      "pattern": "^([0-9a-f]{2})*$"
    },
    "provenance": {
      "description": "Where the expected values came from. Exactly two kinds are permitted; see docs/protocol/provenance.md.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "device",
            "date"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "observed"
            },
            "device": {
              "enum": [
                "accentum-wireless",
                "momentum-tw4"
              ]
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "note": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "rationale"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "constructed"
            },
            "rationale": {
              "type": "string",
              "description": "Why this rule matters. A constructed vector asserts what the specification requires, not what hardware was seen to do."
            }
          }
        }
      ]
    },
    "vector": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "kind": {
          "enum": [
            "frame",
            "stream",
            "payload",
            "sequence"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "frame"
              }
            }
          },
          "then": {
            "required": [
              "bytes",
              "vendor",
              "feature",
              "type",
              "operation",
              "payload"
            ],
            "additionalProperties": false,
            "properties": {
              "id": true,
              "kind": true,
              "provenance": true,
              "bytes": {
                "$ref": "#/$defs/hex"
              },
              "vendor": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              "feature": {
                "type": "integer",
                "minimum": 0,
                "maximum": 127
              },
              "type": {
                "enum": [
                  "command",
                  "notification",
                  "response",
                  "error"
                ]
              },
              "operation": {
                "type": "integer",
                "minimum": 0,
                "maximum": 127
              },
              "payload": {
                "$ref": "#/$defs/hex"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "stream"
              }
            }
          },
          "then": {
            "required": [
              "chunks",
              "frames",
              "remainder"
            ],
            "additionalProperties": false,
            "properties": {
              "id": true,
              "kind": true,
              "provenance": true,
              "chunks": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/hex"
                },
                "description": "Delivered in order; each is one read from the transport."
              },
              "frames": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/hex"
                },
                "description": "Complete frames that must emerge, in order."
              },
              "remainder": {
                "$ref": "#/$defs/hex",
                "description": "Bytes still buffered afterwards; must be carried into the next read."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "payload"
              }
            }
          },
          "then": {
            "required": [
              "command",
              "payload"
            ],
            "additionalProperties": false,
            "properties": {
              "id": true,
              "kind": true,
              "provenance": true,
              "command": {
                "enum": [
                  "error_reason",
                  "battery_level",
                  "battery_types",
                  "battery_charger",
                  "feature_list",
                  "anc_enabled",
                  "anc_transparency",
                  "anc_submodes",
                  "anc_level",
                  "anc_transparency_level",
                  "eq_mode",
                  "eq_configuration",
                  "eq_band_gain",
                  "eq_bass_boost",
                  "conn_paired_count",
                  "conn_own_index",
                  "conn_max_connections",
                  "conn_peer",
                  "fw_version",
                  "fw_version_wide",
                  "product_name",
                  "case_serial",
                  "on_head_detection",
                  "codec",
                  "prompts",
                  "prompt_language"
                ]
              },
              "payload": {
                "$ref": "#/$defs/hex"
              },
              "decoded": {
                "type": "object",
                "description": "Expected decode. Mutually exclusive with 'error'."
              },
              "error": {
                "enum": [
                  "invalid_length",
                  "invalid_value"
                ],
                "description": "Decoding must raise. Mutually exclusive with 'decoded'."
              }
            },
            "oneOf": [
              {
                "required": [
                  "decoded"
                ]
              },
              {
                "required": [
                  "error"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "sequence"
              }
            }
          },
          "then": {
            "required": [
              "sequence",
              "given",
              "writes",
              "verify"
            ],
            "additionalProperties": false,
            "properties": {
              "id": true,
              "kind": true,
              "provenance": true,
              "sequence": {
                "enum": [
                  "anc_mode",
                  "anc_state",
                  "anc_level",
                  "anc_submode"
                ],
                "description": "Which planner produces this sequence."
              },
              "given": {
                "type": "object",
                "description": "The inputs the plan is built from. A plan depends on current device state, so it cannot be pinned without one."
              },
              "writes": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/hex"
                },
                "description": "Complete frames to send, in order. Order is part of the contract, not an implementation detail."
              },
              "verify": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/hex"
                },
                "description": "The read that proves each write, positionally matched to 'writes'. A setter acknowledges without reporting state, so a sequence without these is unverifiable."
              }
            }
          }
        }
      ]
    }
  }
}
