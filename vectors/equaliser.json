      "payload": "00",
      "decoded": { "gain_db": 0.0 },
      "provenance": {
        "kind": "observed",
        "device": "accentum-wireless",
        "date": "2026-09-09",
        "note": "All five bands read as zero on both devices, the equaliser being off."
      }
    },
    {
      "id": "band-gain-positive",
      "kind": "payload",
      "command": "eq_band_gain",
      "payload": "1e",
      "decoded": { "gain_db": 3.0 },
      "provenance": {
        "kind": "constructed",
        "rationale": "Pins the tenths-of-a-decibel scale. A decoder treating the byte as whole decibels would report 30 dB here."
      }
    },
    {
      "id": "band-gain-negative",
      "kind": "payload",
      "command": "eq_band_gain",
      "payload": "c4",
      "decoded": { "gain_db": -6.0 },
      "provenance": {
        "kind": "constructed",
        "rationale": "The byte is signed. A decoder reading it as unsigned would report +19.6 dB — above the maximum the same device advertises."
      }
    },
    {
      "id": "band-gain-minus-one-tenth",
      "kind": "payload",
      "command": "eq_band_gain",
      "payload": "ff",
      "decoded": { "gain_db": -0.1 },
      "provenance": {
        "kind": "constructed",
        "rationale": "0xff is the smallest negative step, not an unavailable sentinel. Unlike the battery triplet, this field has no such sentinel."
      }
    },
