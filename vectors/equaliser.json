      },
      "provenance": {
        "kind": "constructed",
        "rationale": "The byte is signed. A decoder reading it as unsigned would report +19.6 dB — above the maximum the same device advertises."
      }
    },
    {
      "id": "band-gain-minus-one-tenth",
