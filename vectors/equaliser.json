      "decoded": { "value": 1, "name": "user_eq" },
      "provenance": {
        "kind": "constructed",
        "rationale": "Both devices had the equaliser off when captured. Pins the value that band gains depend on."
      }
    },
    {
      "id": "mode-unknown-value-kept",
