    {
      "id": "anc-off",
      "kind": "payload",
      "command": "anc_enabled",
      "payload": "00",
      "decoded": { "enabled": false },
      "provenance": {
        "kind": "constructed",
        "rationale": "Both devices happened to have ANC on when captured. The off value is required by the specification and is pinned so a decoder cannot pass by returning true unconditionally."
      }
    },
    {
      "id": "anc-invalid-state",
      "kind": "payload",
      "command": "anc_enabled",
      "payload": "02",
      "error": "invalid_value",
      "provenance": {
        "kind": "constructed",
        "rationale": "The field is a two-valued flag, not a truthiness test. Rejecting other values stops an unexpected reading being silently reported as on."
      }
    },
    {
