    {
      "id": "scalar-ff-is-not-unavailable",
      "kind": "payload",
      "command": "battery_level",
      "payload": "ff",
      "decoded": { "shape": "scalar", "level": 2.55 },
      "provenance": {
        "kind": "constructed",
        "rationale": "The single-byte shape has no 0xff special case, unlike the triplet. 0xff decodes as 255/100. This asymmetry is the most likely source of a wrong reading, so it is pinned rather than left implicit. A decoder that returns null here is wrong; one that clamps to 1.0 is also wrong."
      }
    },
